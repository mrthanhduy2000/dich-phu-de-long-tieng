+class _Lease:
+    """[CST patch] One stream slot, released exactly once.
+
+    ``speech()`` takes the slot before the response starts and the generator's
+    ``finally`` gives it back. When the client disconnects (a seek, a client-side
+    timeout) Starlette simply stops iterating the sync generator: it stays
+    suspended at a ``yield``, ``finally`` never runs, the slot stays taken and
+    every later request gets 429 until the server restarts (seen in practice).
+    A watchdog frees the slot when the stream has not advanced for ``idle``
+    seconds; a suspended generator uses no CPU, so this is safe.
+    """
+
+    def __init__(self, eng: "Engine", idle: float = 4.0):
+        self.eng = eng
+        self.idle = idle
+        self.last = time.monotonic()
+        self._done = False
+        self._lock = threading.Lock()
+        self._schedule()
+
+    def _schedule(self) -> None:
+        t = threading.Timer(1.0, self._check)
+        t.daemon = True
+        t.start()
+
+    def touch(self) -> None:
+        self.last = time.monotonic()
+
+    def _check(self) -> None:
+        if self._done:
+            return
+        if time.monotonic() - self.last > self.idle:
+            if self.release():
+                log.warning("released a stream slot idle for %.0fs (client left)", self.idle)
+            return
+        self._schedule()
+
+    def release(self) -> bool:
+        with self._lock:
+            if self._done:
+                return False
+            self._done = True
+        self.eng.release()
+        return True
+
+
