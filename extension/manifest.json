{
    "manifest_version": 3,
    "name": "Vietnamese Subtitle Translator (Coursera + YouTube)",
    "description": "Dịch phụ đề Coursera, YouTube và các trang video khác sang tiếng Việt với Gemini AI và Lồng tiếng",
    "version": "2.5.0",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "yt-bridge.js"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.coursera.org/*",
                "*://*.youtube.com/*"
            ],
            "js": [
                "glossary.js",
                "cst-cache.js",
                "cost-policy.js",
                "lang-detect.js",
                "vi-segmenter.js",
                "subtitle-style.js",
                "subtitle-edits.js",
                "player-ui.js",
                "transcript.js",
                "context-engine.js",
                "vi-quality.js",
                "dub-planner.js",
                "dub-prosody.js",
                "dub-speech.js",
                "dub-audio.js",
                "dub-engine.js",
                "dubbing.js",
                "content.js",
                "youtube.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.coursera.org/*",
        "*://*.youtube.com/*",
        "https://translate.googleapis.com/*",
        "https://translate.google.com/*",
        "https://clients5.google.com/*",
        "https://api.mymemory.translated.net/*",
        "https://generativelanguage.googleapis.com/*",
        "https://fonts.googleapis.com/*",
        "https://fonts.gstatic.com/*",
        "http://127.0.0.1:8000/*"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "web_accessible_resources": [
        {
            "resources": [
                "images/*",
                "icons/*"
            ],
            "matches": [
                "*://*.youtube.com/*",
                "*://*.coursera.org/*"
            ]
        }
    ],
    "commands": {
        "bat-tat-phu-de": {
            "suggested_key": {
                "default": "Alt+S"
            },
            "description": "Bật/tắt phụ đề tiếng Việt"
        },
        "bat-tat-long-tieng": {
            "suggested_key": {
                "default": "Alt+D"
            },
            "description": "Bật/tắt lồng tiếng Việt"
        },
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+V"
            },
            "description": "Mở bảng điều khiển tiện ích"
        }
    }
}
